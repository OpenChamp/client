[layer_names]

3d_physics/layer_1="Environment Static"
3d_navigation/layer_1="Environment Static"
3d_physics/layer_5="Structures"
3d_navigation/layer_5="Structures"
3d_physics/layer_9="Blue Team (1) Entites"
3d_navigation/layer_9="Blue Team (1) Entites"
3d_physics/layer_10="Red Team (2) Entities"
3d_navigation/layer_10="Red Team (2) Entites"

[navigation]

3d/default_cell_size=0.5

[physics]

3d/default_gravity=0.0
3d/default_gravity_vector=Vector3(0, 0, 0)

[rendering]

textures/vram_compression/import_etc2_astc=true
