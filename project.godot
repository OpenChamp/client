; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OpenChamp"
config/description="An open-source Multiplayer Online Battle Arena writtin with Godot and GDScript"
config/version="0.0.1"
run/main_scene="uid://bxm57ka4nof1o"
config/use_custom_user_dir=true
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0.14117648, 0.14117648, 0.14117648, 0)
boot_splash/image="uid://p00q1t0d0js2"
config/icon="res://default_assets/textures/openchamp.png"
boot/splash="res://default_assets/textures/openchamp.png"

[audio]

buses/default_bus_layout="uid://ddwso3ogy7vee"

[autoload]

CsgToolkitAutoload="*uid://w8ad8q4lneis"
GameManager="*res://scripts/managers/game_manager.gd"
AudioManager="*res://scripts/managers/_AudioManager.gd"
ConfigManager="*res://scripts/managers/_ConfigManager.gd"
UIManager="*res://scripts/managers/_UIManager.gd"
WSManager="*res://scripts/managers/_WS_Manager.gd"
SpawnManager="*res://scripts/managers/_SpawnManager.gd"
NetworkManager="*res://scripts/managers/_NetworkManager.gd"
DebugMenu="*uid://cggqb75a8w8r"
IOManager="*res://scripts/managers/_IOManager.gd"
EntityManager="*uid://tc6y88mvjayk"

[debug]

gdscript/warnings/shadowed_variable=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/initial_position_type=5
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="OpenChamp"

[editor]

run/main_run_args="-ip 127.0.0.1"

[editor_plugins]

enabled=PackedStringArray("res://addons/PathMesh3D/plugin.cfg", "res://addons/csg_toolkit/plugin.cfg", "res://addons/debug_menu/plugin.cfg", "res://addons/eam/plugin.cfg")

[global_group]

game_root="The root of the game scene"
team1="Red Team"
team2="Blue Team"
minion_spawn="Minion Spawn Points"
map_root="The root of the map scene"

